# Copy to .env.local and fill in. .env.local is gitignored.

# Local OWUI dev stack (matches docker-compose.yml).
OWUI_HOST=http://localhost:3000
OWUI_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxx
OWUI_MODEL=gemma-4-26b-a4b

# Emulator platform name. Pebble Time 2 = emery.
# (flint = Pebble 2 Duo, gabbro = Pebble Round 2.)
EMU_PLATFORM=emery
